# Copie para .env e ajuste. Não commite o .env com valores reais.
# Usado pelo docker-compose.yml (referências ${VAR}).

# Caminhos dos repos de servico (pastas irmaas deste repo).
# Por padrao o compose usa os nomes gerados pelo `git clone` no GitHub.
# Se renomeou as pastas localmente, descomente e ajuste:
# USERS_API_PATH=../fcg-users-api
# CATALOG_API_PATH=../fcg-catalog-api
# PAYMENTS_API_PATH=../fcg-payments-api
# NOTIFICATIONS_API_PATH=../fcg-notifications-api
# (em producao o NotificationsAPI e uma funcao AWS Lambda, com deploy proprio via
# `sam deploy` naquele repo; aqui o codigo dele so e usado para rodar as funcoes
# localmente no emulador da Lambda, atras do Kong)
POSTGRES_USER=fcg
POSTGRES_PASSWORD=fcg123

RABBITMQ_USER=fcg
RABBITMQ_PASS=fcg123

# Cache do catalog-api (GET de jogos e da biblioteca). Vira a ACL do container
# Redis e a connection string do servico -- os dois leem estas mesmas variaveis,
# entao trocar a senha aqui basta.
REDIS_USER=fcg
REDIS_PASS=fcg123

# Mesma chave usada por users (emite) e catalog (valida) o JWT.
JWT_SECRET_KEY=6a8a56f4d31a272d6e2f048f710c9cce45b51aa343fd6f73d8b69f1218eaac56

# ---------- API Gateway (Kong) ----------
# Claim `iss` do JWT. Uma variavel so, lida por DOIS lados:
#   - users-api  -> JwtSettings__Issuer  (emite a claim)
#   - kong       -> valida a claim antes de encaminhar
# Se os dois divergirem, o gateway responde 401 em todas as chamadas
# autenticadas ("No credentials found for given 'iss'").
JWT_ISSUER=FCG

# users-api e payments-api publicam UserRegisteredEvent/PaymentProcessedEvent via SNS
# (consumidos pela Lambda do NotificationsAPI). ARNs abaixo sao os reais do grupo (nao
# sao segredo). As credenciais AWS SIM sao sensiveis: preencha aqui so localmente, no
# .env (nunca commitado) — em produção, use um IAM role em vez de chaves estaticas.
SNS_USER_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:450753703903:fcg-user-events
SNS_PAYMENT_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:450753703903:fcg-payment-events
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------- Observabilidade (New Relic) ----------
# Mesma license key usada pelo agente .NET em users-api, catalog-api e
# payments-api (ver docs/observability.md). Sem ela os tres sobem normalmente,
# so sem o agente ativo -- nao e obrigatoria para rodar localmente.
NEW_RELIC_LICENSE_KEY=
